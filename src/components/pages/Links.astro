---
import linksData from "../../data/links.json";
import { t, url } from "../../lib/site";
import type { LinksData } from "../../lib/page-types";
import { friendBannerPairs } from "../../lib/friend-banner";
const links: LinksData = linksData;
interface Props {
  data?: LinksData;
  title?: string;
  description?: string;
}
const {
  title = t("links"),
  description = "",
  data = links,
} = Astro.props;
const groups: NonNullable<Props["data"]>["links"] = data.links;
const all = groups.flatMap((g) => g.link_list);
const pairs = friendBannerPairs(all);
---

{all.length > 0 && (
  <div
    class="flink tw:[div&]:flex tw:[div&]:overflow-hidden tw:[div&]:relative tw:[div&]:flex-col"
    id="banners"
  >
    <div class="banners-title tw:absolute tw:flex tw:flex-col">
      <div class="banners-title-small">{description}</div>
      <div class="banners-title-big">{title}</div>
    </div>
    <div class="tags-group-all nowrapMove tw:flex" aria-label={title}>
      {[0, 1].map((row) => (
        <div class:list={["tags-group-wrapper", { "tags-group-wrapper--reverse": row === 1 }]}>
          {[0, 1].map((copy) => (
            <div class="tags-group-sequence" aria-hidden={copy === 1 ? "true" : undefined}>
              {pairs.map((pair) => {
                const item = pair[row]!;
                return (
                  <a
                    class="tags-group-icon"
                    href={item.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={item.name}
                    aria-label={item.name}
                    tabindex={copy === 1 ? -1 : undefined}
                  >
                    <img
                      class="no-lightbox"
                      src={url(item.avatar ?? "/img/icons/favicon.png")}
                      alt=""
                    />
                  </a>
                );
              })}
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
)}
{all.length === 0 && (
  <header class="page-title-wrap friend-links-heading">
    <h1 class="page-title">{title}</h1>
    {description && <p>{description}</p>}
  </header>
)}
<div class="flink article-container" id="friend-links-list">
  {all.length === 0 && <p class="friend-links-empty">{t("linksEmpty")}</p>}
  {groups.map((g) => (
    <>
      <h2>
        {g.class_name} ({g.link_list.length})
      </h2>
      <div class="flink-desc">{g.class_desc}</div>
      {g.type === "card" ? (
        <div class="site-card-group">
          {g.link_list.map((item) => (
            <div class="site-card">
              {item.tag && <span class="site-card-tag">{item.tag}</span>}
              <a
                class="img"
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                title={item.name}
              >
                <img
                  class="flink-avatar no-lightbox"
                  src={url(item.topimg ?? item.avatar)}
                  alt={item.name}
                />
              </a>
              <a
                class="info cf-friends-link"
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                title={item.name}
              >
                <div class="site-card-avatar">
                  <img
                    class="flink-avatar cf-friends-avatar no-lightbox"
                    src={url(item.avatar ?? "/img/icons/favicon.png")}
                    alt=""
                  />
                  <div class="img-alt is-center">{item.name}</div>
                </div>
                <div class="site-card-text">
                  <span class="title cf-friends-name">{item.name}</span>
                  <span class="desc">{item.descr}</span>
                </div>
              </a>
            </div>
          ))}
        </div>
      ) : (
        <div class="flink-list">
          {g.link_list.map((item) => (
            <div class="flink-list-item tw:[.article-container_&]:relative tw:[.article-container_&]:flex tw:[.article-container_&]:overflow-hidden">
              <a
                class="cf-friends-link"
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                title={item.name}
              >
                <img
                  class="flink-avatar cf-friends-avatar no-lightbox"
                  src={url(item.avatar ?? "/img/icons/favicon.png")}
                  alt=""
                />
                <div class="flink-item-info">
                  <span class="flink-item-name cf-friends-name">
                    {item.name}
                  </span>
                  <span class="flink-item-desc" title={item.descr}>
                    {item.descr}
                  </span>
                </div>
              </a>
            </div>
          ))}
        </div>
      )}
    </>
  ))}
  <slot />
</div>
