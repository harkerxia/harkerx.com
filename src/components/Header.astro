---
import I18n from "./I18n.astro";
import { cfg, config, t, url } from '../lib/site';
import type { Post } from '../lib/content';
import type { ThemeLink } from '../lib/config';
import Menu from './Menu.astro';
import PostMeta from './PostMeta.astro';
interface Props {
  title: string;
  post?: Post;
}
const { title, post } = Astro.props;
const cover =
  post && !post.data.not_cover
    ? (post.data.cover ?? cfg.post.default.cover[0])
    : undefined;
const navButtons: ThemeLink[] = [
  ...cfg.nav.right.custom,
  ...(cfg.nav.right.random
    ? [{ name: t('randomPost'), icon: 'fas fa-shuffle', action: 'randomPost', id: 'randomPost_button' }]
    : []),
  ...(cfg.search.enable
    ? [{ name: t('search'), icon: 'fas fa-magnifying-glass', id: 'search-button' }]
    : []),
];
const navOrder = new Map(cfg.nav.right.order.map((id, index) => [id, index]));
const unspecifiedOrder = cfg.nav.right.order.length;
navButtons.sort(
  (a, b) =>
    (navOrder.get(a.id ?? '') ?? unspecifiedOrder) -
    (navOrder.get(b.id ?? '') ?? unspecifiedOrder),
);
---

<header
  id="page-header"
  class:list={[cover ? 'post-bg' : 'not-top-img', 'nav-at-top']}
  class="tw:relative tw:flex tw:justify-center"
>
  <nav
    id="nav"
    class="show tw:[#page-header_&]:flex tw:[#page-header_&]:justify-center tw:absolute tw:flex tw:flex-wrap tw:items-center tw:justify-between"
    data-solitude-action="onNavBlankClickCloseConsole"
    data-solitude-event="true"
  >
    <div
      id="nav-group"
      class="tw:[#page-header_#nav_&]:flex tw:[#page-header_#nav_&]:relative tw:[#page-header_#nav_&]:items-center"
    >
      <div
        id="blog_name"
        class="tw:[#nav_&]:flex tw:[#nav_&]:items-center tw:[#nav_&]:absolute"
      >
        {Object.keys(cfg.nav.group).length > 0 && (
          <div
            class="back-home-button tw:flex tw:items-center tw:justify-center"
          >
            <button
              class="back-home-trigger"
              type="button"
              aria-label="Navigation links" data-i18n-aria-label-text="Navigation links"
              aria-expanded="false"
              aria-controls="nav-connect-links"
            >
            <svg
              class="back-home-button-icon"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M6.75 2.5C9.1 2.5 11 4.4 11 6.75V11H6.75a4.25 4.25 0 1 1 0-8.5ZM6.75 13H11v4.25A4.25 4.25 0 1 1 6.75 13ZM17.25 2.5a4.25 4.25 0 0 1 0 8.5H13V6.75a4.25 4.25 0 0 1 4.25-4.25ZM13 13h4.25A4.25 4.25 0 1 1 13 17.25Z" />
            </svg>
            </button>
            <div id="nav-connect-links" class="back-menu-list-groups tw:[.back-home-button_&]:absolute tw:[.back-home-button_&]:flex-col">
              {Object.entries(cfg.nav.group)
                .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
                .map(([name, items]) => (
                  <div class="back-menu-list-group tw:[.back-home-button_&]:flex tw:[.back-home-button_&]:flex-col">
                    <div class="back-menu-list-title"><I18n text={name} /></div>
                    <div class="back-menu-list tw:flex tw:flex-row tw:flex-wrap tw:justify-between tw:[#sidebar_#sidebar-menus_.back-menu-list-groups_&]:justify-start">
                      {items.map((item) => (
                        <a
                          class="back-menu-item tw:flex tw:items-center"
                          href={url(item.url)}
                        >
                          {item.icon && (
                            /^(?:fa[a-z]*|fa-[a-z-]+)\s/.test(item.icon) ? (
                              <span class="back-menu-item-icon back-menu-item-icon--font" aria-hidden="true">
                                <i class={item.icon} />
                              </span>
                            ) : (
                              <img
                                class="nolazyload back-menu-item-icon"
                                src={url(item.icon)}
                                alt=""
                              />
                            )
                          )}
                          <span class="back-menu-item-text"><I18n text={item.name} /></span>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
            </div>
          </div>
        )}
        <a
          id="site-name"
          href={url('/')}
          title={t('backHome')} data-i18n-title={'backHome'}
          heotip={t('backHome')} data-i18n-heotip={'backHome'}
          class="tw:[#nav_&]:flex tw:[#nav_&]:justify-center tw:[#nav_&]:items-center tw:[#nav_&]:cursor-pointer"
        >
          {cfg.site.name.class === 'img' ? (
            <img src={url(cfg.site.name.custom)} alt={config.title} />
          ) : cfg.site.name.class === 'i_class' ? (
            <i class={cfg.site.name.custom} />
          ) : (
            <span class="title">{cfg.site.name.custom}</span>
          )}
          <i class="solitude fas fa-home tw:[#nav_#site-name_i.fas&]:absolute tw:[#nav_#site-name_i.fas&]:flex tw:[#nav_#site-name_i.fas&]:items-center tw:[#nav_#site-name_i.fas&]:justify-center" />
        </a>
      </div>
      <div id="page-name-mask">
        <div id="page-name">
          <a
            id="page-name-text"
            data-solitude-action="toTop"
            title={t('backTop')} data-i18n-title={'backTop'}
            heotip={t('backTop')} data-i18n-heotip={'backTop'}
          >
            {post ? title : <I18n text={title} />}
          </a>
        </div>
      </div>
      <div
        id="menus"
        class="tw:[#nav_&]:flex tw:[#nav_&]:justify-center tw:[#nav_&]:absolute"
      >
        <Menu />
      </div>
      <div id="nav-left" />
      <div
        id="nav-right"
        class="tw:[#page-header_#nav_&]:absolute tw:[#page-header_#nav_&]:flex tw:[#page-header_#nav_&]:flex-row tw:[#page-header_#nav_&]:items-center tw:[#page-header_#nav_&]:overflow-hidden"
      >
        {navButtons.map((item) => (
          <div
            class="nav-button tw:[#page-header_#nav_#nav-right_&]:cursor-pointer"
            id={item.id}
          >
            <a
              class:list={["site-page tw:[#nav_&]:relative tw:[#nav_&]:cursor-pointer tw:[#sidebar_#sidebar-menus_.menus\_items_&]:relative tw:[#sidebar_#sidebar-menus_.menus\_items_&]:block tw:[#sidebar_#sidebar-menus_.menus\_items_&]:cursor-pointer tw:[#sidebar_#sidebar-menus_.menus\_items_.menus\_item_>_&]:flex", { "social-icon": item.id === "search-button", search: item.id === "search-button" }]}
              href={url(item.url ?? '#')}
              data-astro-reload={item.id === 'rss-feed' ? true : undefined}
              data-solitude-action={item.action}
              data-solitude-prevent={item.action ? 'true' : undefined}
              aria-label={item.title ?? item.name} data-i18n-aria-label-text={item.title ?? item.name}
              title={item.title ?? item.name} data-i18n-title-text={item.title ?? item.name}
              heotip={item.title ?? item.name} data-i18n-heotip-text={item.title ?? item.name}
            >
              <i class={`solitude ${item.icon}`} />
            </a>
          </div>
        ))}
        <div class="nav-button nav-language-button">
          <button
            id="language-switch"
            class="language-switch-trigger"
            type="button"
            data-ui-language-switch
            aria-label="Switch to Chinese"
            title="Switch to Chinese"
          >
            <span data-ui-language-label>中文</span>
          </button>
        </div>
        {cfg.console.enable && (
          <div
            class="nav-button tw:[#page-header_#nav_#nav-right_&]:cursor-pointer"
            id="nav-console"
          >
            <a
              class="console_switchbutton"
              href="#"
              data-solitude-action="toggleConsole"
              data-solitude-prevent="true"
              aria-label={t('console')} data-i18n-aria-label={'console'}
              title={t('console')} data-i18n-title={'console'}
              heotip={t('console')} data-i18n-heotip={'console'}
            >
              <label>
                <i class="left" />
                <i class="center" />
                <i class="right" />
              </label>
            </a>
          </div>
        )}
        <div
          class="nav-button tw:[#page-header_#nav_#nav-right_&]:cursor-pointer tw:[#page-header.nav-at-top_#nav-right_&]:overflow-hidden tw:relative tw:flex tw:items-center"
          id="nav-totop"
          data-solitude-action="toTop"
          title={t('backTop')} data-i18n-title={'backTop'}
          heotip={t('backTop')} data-i18n-heotip={'backTop'}
        >
          <a class="totopbtn tw:[#page-header_#nav_#nav-right_.nav-button_a&]:absolute">
            <i class="solitude fas fa-arrow-up" />
            <span
              id="percent"
              class="tw:[#nav-totop_&]:flex tw:[#nav-totop_&]:justify-center tw:[#nav-totop_&]:items-center tw:[#nav-totop_&]:whitespace-nowrap"
            >
              0
            </span>
          </a>
        </div>
        <div id="toggle-menu">
          <a
            class="site-page tw:[#nav_&]:relative tw:[#nav_&]:cursor-pointer tw:[#sidebar_#sidebar-menus_.menus\_items_&]:relative tw:[#sidebar_#sidebar-menus_.menus\_items_&]:block tw:[#sidebar_#sidebar-menus_.menus\_items_&]:cursor-pointer tw:[#sidebar_#sidebar-menus_.menus\_items_.menus\_item_>_&]:flex"
            href="#"
            aria-label={t('menu')} data-i18n-aria-label={'menu'}
          >
            <i class="solitude fas fa-bars" />
          </a>
        </div>
      </div>
    </div>
  </nav>
  {cover && post && (
    <>
      <div class="post-cover-aside tw:[.post_&]:absolute tw:[.post_&]:block tw:[.post_&]:overflow-hidden">
        <a
          class="post-cover-aside-link fancybox tw:[.post_.post-cover-aside_&]:block"
          href={url(cover)}
        >
          <img
            id="post-cover"
            class="post-cover-aside-img nolazyload tw:[.post_.post-cover-aside_&]:block tw:[.post_.post-cover-aside_&]:object-cover"
            src={url(cover)}
            alt={post.data.title}
          />
        </a>
      </div>
      <PostMeta post={post} />
    </>
  )}
</header>
