---
import { ClientRouter } from "astro:transitions";
import { applyInitialTheme } from "../scripts/theme-bootstrap";
import { cfg, config, url, absolute, json } from "../lib/site";
import { getPosts, getPages, getArticleVersions, deriveArticleSeo, contentPath, type Post } from "../lib/content";
import { runtimeConfig, runtimeLanguagePatch } from "../lib/runtime-config";
import {
  applyUiLanguage,
  bootstrapUiLanguage,
  normalizeUiLocale,
  uiCopies,
} from "../lib/ui-language";
import I18n from "../components/I18n.astro";
import { buildArticleCatalog } from "../lib/article-ui";
import type { ArticleLanguage } from "../lib/routes";
import { pageCommentsEnabled } from "../lib/comment-policy";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Search from "../components/Search.astro";
import Overlays from "../components/Overlays.astro";
import Capsule from "../components/Capsule.astro";
import "@fortawesome/fontawesome-free/css/all.min.css";
import "katex/dist/katex.min.css";
import mainStyle from "../styles/main.css?url";
import layerOrder from "../styles/layers.css?inline";
import aboutStyle from "../styles/pages/about.css?url";
import notesStyle from "../styles/pages/notes.css?url";
import "../styles/astro.css";
import "../styles/custom.css";
interface Props {
  title?: string;
  description?: string;
  type?: string;
  post?: Post;
  page?: import("../lib/page-types").PageMetadata;
  toc?: boolean;
  article?: ArticleLanguage;
}
const {
  title = config.title,
  description = config.description,
  type = "page",
  post,
  page = {},
  toc = false,
  article,
} = Astro.props;
const posts = await getPosts(),
  pages = await getPages();
const versions = await getArticleVersions();
const articleCatalog = buildArticleCatalog(versions);
const articleSeo = post ? deriveArticleSeo(post, versions, absolute) : undefined;
const defaultUiLocale = normalizeUiLocale(config.locale);
const runtime = runtimeConfig(posts, pages, { ...page, type }, defaultUiLocale, versions);
const runtimeLanguages = Object.fromEntries(
  (["en", "zh-CN"] as const).map((locale) => [
    locale,
    runtimeLanguagePatch(
      runtimeConfig(posts, pages, { ...page, type }, locale, versions),
    ),
  ]),
);
const commentsEnabled =
  Boolean(cfg.comment.use) && pageCommentsEnabled(type, page.comment);
const pageConfig = {
  is_post: Boolean(post),
  is_page: type !== "solitude" && !post,
  is_home: type === "solitude",
  page: type,
  toc: page.toc !== false && Boolean(post || type === "page"),
  comment: commentsEnabled,
  color: page.color ?? false,
};
const canonicalUrl =
  type === "404"
    ? absolute("/404.html")
    : post
      ? absolute(contentPath(post))
      : new URL(Astro.url.pathname, config.site).href;
const vars = {
  "solitude-theme-light": cfg.theme_color.light,
  "solitude-theme-dark": cfg.theme_color.dark,
  "solitude-nav-hover-light": cfg.theme_color.nav_hover_text.light,
  "solitude-nav-hover-dark": cfg.theme_color.nav_hover_text.dark,
  "solitude-font-size": cfg.font.font_size,
  "solitude-code-font-size": cfg.font.code_font_size,
  "solitude-font-family": cfg.font.font_family,
  "solitude-code-font-family": cfg.font.code_font_family,
  "solitude-index-columns": String(cfg.index_post_list.column),
};
const inlineVars = Object.entries(vars)
  .map(([key, value]) => `--${key}:${value}`)
  .join(";");
---

<!doctype html>
<html
  lang={articleSeo?.locale ?? defaultUiLocale}
  data-article-locale={articleSeo?.locale}
  data-ui-language={defaultUiLocale}
  data-theme="light"
  style={inlineVars}
>
  <head>
    <style is:inline set:html={layerOrder}></style>
    <link rel="stylesheet" href={mainStyle} />
    {type === "about" && <link rel="stylesheet" href={aboutStyle} />}
    {type === "notes" && <link rel="stylesheet" href={notesStyle} />}
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title
      data-i18n-text={
        post ? undefined : type === "solitude" ? config.title : title
      }
      data-i18n-suffix={type === "solitude" ? undefined : ` | ${config.title}`}
    >{type==='solitude'?config.title:`${title} | ${config.title}`}</title>
    <meta
      name="description"
      content={description}
      data-i18n-content-text={post ? undefined : description}
    />
    {type === "404" && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={articleSeo?.canonical ?? canonicalUrl} />
    {articleSeo?.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${config.title} — 中文`}
      href={url("/rss.xml")}
    />
    <link rel="alternate" type="application/rss+xml" title={`${config.title} — English`} href={url("/en/rss.xml")} />
    <link rel="icon" href={url(cfg.site.icon)} />
    <meta
      property="og:title"
      content={title}
      data-i18n-content-text={post ? undefined : title}
    />
    <meta
      property="og:description"
      content={description}
      data-i18n-content-text={post ? undefined : description}
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={post ? "article" : "website"} />
    {(post?.data.cover || page.cover) && (
      <meta
        property="og:image"
        content={absolute((post?.data.cover ?? page.cover)!)}
      />
    )}
    {cfg.pwa.enable && (
      <>
        <link rel="manifest" href={url(cfg.pwa.manifest)} />
        <meta name="theme-color" content={cfg.pwa.theme_color} />
        <meta name="mobile-web-app-capable" content="yes" />
        <link
          rel="apple-touch-icon"
          sizes="180x180"
          href={url(cfg.pwa.apple_touch_icon)}
        />
        {cfg.pwa.mask_icon.endsWith(".svg") && (
          <link
            rel="mask-icon"
            href={url(cfg.pwa.mask_icon)}
            color={cfg.pwa.theme_color}
          />
        )}
        <link
          rel="icon"
          type="image/png"
          sizes="16x16"
          href={url(cfg.pwa.favicon_16_16)}
        />
        <link
          rel="icon"
          type="image/png"
          sizes="32x32"
          href={url(cfg.pwa.favicon_32_32)}
        />
        <link rel="bookmark" href={url(cfg.pwa.bookmark_icon)} />
      </>
    )}

    <ClientRouter />
    <script
      is:inline
      data-astro-rerun
      set:html={`(${bootstrapUiLanguage.toString()})(${json(defaultUiLocale)});`}
    ></script>
    <script
      is:inline
      data-astro-rerun
      set:html={`(${applyInitialTheme.toString()})(${json(cfg.display_mode.type)});`}
    ></script>
    <template id="site-config" set:html={json(runtime)} />
    <template id="site-ui-config" set:html={json(runtimeLanguages)} />
    <template id="site-ui-copy" set:html={json(uiCopies)} />
    <template id="article-catalog" set:html={json(articleCatalog)} />
    <template id="config-diff" set:html={json(pageConfig)} />
    {article && <template id="article-language" set:html={json(article)} />}
    {cfg.verify_site.map((html: string) => (
      <Fragment set:html={html} />
    ))}
    {cfg.extends.head.map((html: string) => (
      <Fragment set:html={html} />
    ))}
  </head>
  <body
    class:list={{
      "solitude-memorial":
        cfg.memorial.enable &&
        cfg.memorial.date.includes(
          new Intl.DateTimeFormat("sv-SE", { timeZone: config.timeZone })
            .format(new Date())
            .slice(5),
        ),
    }}
    id="body"
    data-type={type}
    data-search={cfg.search.type}
    data-aside-position={cfg.aside.position}
    data-index-layout={cfg.index_post_list.direction}
  >
    {cfg.loading.fullpage && (
      <div id="loading-box" aria-hidden="true">
        <img src={url(cfg.site.icon)} alt="" />
      </div>
    )}
    {cfg.loading.pace && <div id="navigation-progress" aria-hidden="true" />}
    <a class="skip-link" href="#content-inner">
      <I18n k="startReading" />
    </a>
    <Overlays posts={posts} toc={toc} comments={commentsEnabled} />
    <div
      id="body-wrap"
      class={type === "404" ? "error" : post ? "post" : "page"}
    >
      <Header title={title} post={post} />
      <slot />
      {type !== "404" && <Footer />}
    </div>
    <Search />
    <Capsule />
    <script
      is:inline
      data-astro-rerun
      set:html={`(${applyUiLanguage.toString()})(document, document.documentElement.dataset.uiLanguage === "zh-CN" ? "zh-CN" : "en", JSON.parse(document.getElementById("site-ui-copy").content.textContent));`}
    ></script>
    <script>
      import "../scripts/entry";
    </script>
    {cfg.extends.body.map((html: string) => (
      <Fragment set:html={html} />
    ))}
  </body>
</html>
