---
import I18n from "./I18n.astro";
import ArticleWordTotal from "./ArticleWordTotal.astro";
import { cfg, config, t, url, dateLabel, isoDate } from "../lib/site";
import { taxonomy, type Post } from "../lib/content";
import Menu from "./Menu.astro";
interface Props {
  posts: Post[];
  comments?: boolean;
  toc?: boolean;
}
const { posts, comments = false, toc = false } = Astro.props;
const tags = taxonomy(posts, "tags");
const categories = taxonomy(posts, "categories");
const updated = new Date();
const rssLink = cfg.nav.right.custom.find((item) => item.id === "rss-feed");
const themeSwitch = cfg.nav.right.custom.find((item) => item.id === "theme-toggle");
const actionLabels: Record<string, string> = {
  toggleKeyboard: "keyboardDisable",
  showConsole: "keyboardConsole",
  musicToggle: "keyboardMusic",
  toggleTheme: "keyboardThemeDark",
  openSearch: "keyboardSearch",
  randomPost: "keyboardRandomPost",
};
const months = [
  ...new Set(posts.map((p) => p.data.date.toISOString().slice(0, 7))),
].slice(0, 5);
const contextItems = [
  ["copytext", "clone", "rightMenuCopy"],
  ["pastetext", "clipboard", "rightMenuPaste"],
  ...(cfg.comment.use
    ? [["commenttext", "comment-medical", "rightMenuComment"]]
    : []),
  ["newwindow", "window-maximize", "rightMenuNew"],
  ["copylink", "link", "rightMenuLink"],
  ["copyimg", "clone", "rightMenuImage"],
  ["downloadimg", "cloud-arrow-down", "rightMenuDownloadImage"],
  ...(cfg.search.enable
    ? [["search", "magnifying-glass", "rightMenuSearch"]]
    : []),
  ...(cfg.capsule.enable
    ? [
        ["music-toggle", "play", "rightMenuMusicStart"],
        ["music-back", "backward", "rightMenuMusicBack"],
        ["music-forward", "forward", "rightMenuMusicForward"],
        ["music-copyMusicName", "clone", "rightMenuMusicCopy"],
      ]
    : []),
];
---

{cfg.console.enable && (
  <div
    id="console"
    class="tw:flex tw:justify-center tw:flex-col tw:items-center"
  >
    <div class="console-content tw:[#console_&]:flex tw:[#console_&]:relative tw:[#console_&]:justify-center tw:[#console_&]:flex-col tw:[#console_&]:items-center">
      <div
        class="console-card-group tw:[#console_&]:flex tw:[#console_&]:justify-center tw:[#console_&]:items-center"
        data-solitude-action="onConsoleCardGroupClick"
        data-solitude-event="true"
      >
        {cfg.comment.use && cfg.console.recentComment.enable && (
          <div class="console-card-group-left">
            <div
              class="console-card tw:[#console_&]:flex tw:[#console_&]:flex-col"
              id="card-newest-comments"
              data-solitude-action="hideConsole"
            >
              <div class="card-content tw:[#aside-content_.card-widget_&]:relative tw:[#aside-content_.card-widget_&]:flex tw:[#aside-content_.card-widget_&]:flex-col tw:[.author-content-item_&]:absolute tw:[.author-content-item_&]:flex tw:[.author-content-item_&]:flex-col">
                <div class="author-content-item-tips">
                  <I18n k="recentComments" />
                </div>
                <div class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
                  <I18n k="comments" />
                  {cfg.recent_comments.enable && (
                    <a
                      class="recent-comment-more tw:[.card-recent-comment_&]:inline-flex tw:[.card-recent-comment_&]:items-center tw:[.card-recent-comment_&]:justify-center tw:[#console_&]:flex tw:[#console_&]:items-center"
                      href={url(cfg.recent_comments.page)}
                      title={t("more")} data-i18n-title={"more"}
                      aria-label={t("more")} data-i18n-aria-label={"more"}
                    >
                      <i class="solitude fas fa-circle-chevron-right" />
                    </a>
                  )}
                </div>
              </div>
              <div
                class="console_recentcomments tw:[div&]:flex tw:[div&]:flex-wrap"
                data-comment-provider={cfg.comment.use}
                aria-live="polite"
                aria-busy="true"
              >
                <div class="comment-loading tw:[.card-recent-comment_&]:inline-flex tw:[.card-recent-comment_&]:items-center">
                  <I18n k="commentsLoading" />
                </div>
              </div>
            </div>
          </div>
        )}
        {(cfg.console.card.tags || cfg.console.card.archive) && (
          <div class="console-card-group-right tw:[#console_&]:flex tw:[#console_&]:flex-col tw:[#console_&]:justify-center">
            {cfg.console.card.tags && (
              <div
                class="console-card tags tw:[#console_&]:flex tw:[#console_&]:flex-col"
                data-solitude-action="hideConsole"
              >
                <div class="card-content tw:[#aside-content_.card-widget_&]:relative tw:[#aside-content_.card-widget_&]:flex tw:[#aside-content_.card-widget_&]:flex-col tw:[.author-content-item_&]:absolute tw:[.author-content-item_&]:flex tw:[.author-content-item_&]:flex-col">
                  <div class="author-content-item-tips"><I18n k="tags" /></div>
                  <div class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
                    <I18n k="explore" />
                  </div>
                </div>
                <div class="card-tag-cloud tw:overflow-hidden tw:relative tw:flex tw:flex-row tw:flex-wrap tw:[#console_.console-card.tags_&]:flex tw:[#console_.console-card.tags_&]:flex-wrap tw:[#sidebar_#sidebar-menus_&]:flex tw:[#sidebar_#sidebar-menus_&]:whitespace-nowrap tw:[#sidebar_#sidebar-menus_&]:flex-row tw:[#sidebar_#sidebar-menus_&]:flex-wrap">
                  {tags.slice(0, 20).map((tag) => (
                    <a href={url(tag.path)}>
                      {tag.name}
                      <sup>{tag.posts.length}</sup>
                    </a>
                  ))}
                </div>
              </div>
            )}
            {cfg.console.card.archive && (
              <div
                class="console-card history tw:[#console_&]:flex tw:[#console_&]:flex-col"
                data-solitude-action="hideConsole"
              >
                <ul class="card-archive-list tw:[#console_.console-card.history_&]:flex tw:[#console_.console-card.history_&]:flex-row tw:[#console_.console-card.history_&]:flex-wrap">
                  {months.map((month) => (
                    <li class="item">
                      <a href={url("/archives/")}>
                        <span class="date">{month}</span>
                        <div class="count-group tw:[#console_.console-card.history_.card-archive-list_a_&]:flex tw:[#console_.console-card.history_.card-archive-list_a_&]:flex-row">
                          <span class="count tw:[#console_.console-card.history_.card-archive-list_a_.count-group_&]:text-left">
                            {
                              posts.filter((p) =>
                                p.data.date.toISOString().startsWith(month),
                              ).length
                            }
                          </span>
                          <span class="unit tw:[#console_.console-card.history_.card-archive-list_a_.count-group_&]:text-left">
                            <I18n k="postUnit" />
                          </span>
                        </div>
                      </a>
                    </li>
                  ))}
                  <li class="item">
                    <a href={url("/archives/")}>
                      <span class="date"><I18n k="allPosts" /></span>
                      <div class="count-group tw:[#console_.console-card.history_.card-archive-list_a_&]:flex tw:[#console_.console-card.history_.card-archive-list_a_&]:flex-row">
                        <span class="count tw:[#console_.console-card.history_.card-archive-list_a_.count-group_&]:text-left">
                          {posts.length}
                        </span>
                        <span class="unit tw:[#console_.console-card.history_.card-archive-list_a_.count-group_&]:text-left">
                          <I18n k="postUnit" />
                        </span>
                      </div>
                    </a>
                  </li>
                </ul>
              </div>
            )}
          </div>
        )}
      </div>
      <div class="button-group tw:[#console_&]:flex tw:[#console_&]:justify-center">
        <div class="console-btn-item tw:[#console_.button-group_&]:cursor-pointer">
          <button
            class="darkmode_switchbutton tw:[#sidebar_#sidebar-menus_.sidebar-menu-item_&]:cursor-pointer"
            data-solitude-action="toggleTheme"
            aria-label={t("toggleTheme")} data-i18n-aria-label={"toggleTheme"}
          >
            <i class="solitude fas fa-circle-half-stroke" />
          </button>
        </div>
        <div
          class="console-btn-item tw:[#console_.button-group_&]:cursor-pointer"
          id="consoleHideAside"
        >
          <button
            class="asideSwitch"
            data-solitude-action="switchHideAside"
            aria-label={t("toggleAside")} data-i18n-aria-label={"toggleAside"}
          >
            <i class="solitude fas fa-arrows-left-right-to-line" />
          </button>
        </div>
        {cfg.keyboard.enable && (
          <div
            class="console-btn-item tw:[#console_.button-group_&]:cursor-pointer"
            id="consoleKeyboard"
          >
            <button
              class="keyboardSwitch"
              type="button"
              data-solitude-action="switchKeyboard"
              aria-label={t("keyboardToggle")} data-i18n-aria-label={"keyboardToggle"}
              aria-pressed="false"
            >
              <i class="solitude fas fa-keyboard" />
            </button>
          </div>
        )}
        {cfg.capsule.enable && (
          <div
            class="console-btn-item tw:[#console_.button-group_&]:cursor-pointer"
            id="consoleMusic"
          >
            <button
              class="music-switch"
              data-solitude-action="musicToggle"
              aria-label={t("keyboardMusic")} data-i18n-aria-label={"keyboardMusic"}
            >
              <i class="solitude fas fa-compact-disc" />
            </button>
          </div>
        )}
        {cfg.comment.use && cfg.comment.commentBarrage && (
          <div
            class="console-btn-item on tw:[#console_.button-group_&]:cursor-pointer"
            id="consoleCommentBarrage"
            data-solitude-action="switchCommentBarrage"
          >
            <span class="commentBarrage">
              <i class="solitude fas fa-comment" />
            </span>
          </div>
        )}
      </div>
    </div>
    <div
      class="console-mask tw:[#console_&]:absolute"
      data-solitude-action="hideConsole"
    />
  </div>
)}
{cfg.keyboard.enable && (
  <aside
    id="keyboard-tips"
    aria-hidden="true"
    aria-labelledby="keyboard-title"
    class="tw:flex tw:flex-col"
  >
    <div class="keyboardTitle" id="keyboard-title">
      <I18n k="keyboardTitle" />
    </div>
    <div
      class="keyboardList tw:[#keyboard-tips_&]:flex tw:[#keyboard-tips_&]:flex-col"
      role="list"
    >
      {cfg.keyboard.list.map((item, index: number) => (
        <div
          class="keyboardItem tw:[#keyboard-tips_&]:grid tw:[#keyboard-tips_&]:items-center"
          role="listitem"
          data-shortcut-index={index}
          data-shortcut-action={item.action}
          data-shortcut-custom-label={String(Boolean(item.name))}
          data-theme-light-label={t("keyboardThemeLight")} data-i18n-data-theme-light-label={"keyboardThemeLight"}
          data-theme-dark-label={t("keyboardThemeDark")} data-i18n-data-theme-dark-label={"keyboardThemeDark"}
        >
          <div class="keyGroup tw:[#keyboard-tips_&]:flex tw:[#keyboard-tips_&]:items-center">
            <kbd class="key">
              {item.modifier === "mod" ? "⌘/Ctrl" : "Shift"}
            </kbd>
            <kbd class="key">{item.key}</kbd>
          </div>
          <div class="keyContent">
            <span class="content">
              {item.name
                ? <I18n text={item.name} />
                : <I18n k={actionLabels[item.action ?? ""] ?? item.action ?? ""} />}
            </span>
          </div>
        </div>
      ))}
    </div>
  </aside>
)}
<div id="sidebar">
  <div id="menu-mask" />
  <div id="sidebar-menus" class="tw:[#sidebar_&]:overflow-hidden" role="dialog" aria-modal="true" aria-hidden="true" aria-label={t("menu")} data-i18n-aria-label="menu">
    <div class="mobile-menu-header">
      <button id="mobile-menu-close" class="mobile-menu-close" type="button" aria-label={t("close")} data-i18n-aria-label="close">
        <i class="fas fa-xmark" aria-hidden="true" />
      </button>
      <div class="mobile-menu-brand">
        <div class="mobile-menu-title">{config.title}</div>
        <div class="mobile-menu-description"><I18n text={config.description} /></div>
      </div>
    </div>
    <div class="site-data tw:flex tw:justify-between">
      {[
        { name: "archives", path: "/archives/", count: posts.length },
        { name: "categories", path: "/categories/", count: categories.length },
        { name: "tags", path: "/tags/", count: tags.length },
      ].map((item) => (
        <div class="data-item is-center tw:[.site-data_&]:flex tw:[.site-data_&]:justify-start">
          <div class="data-item-link">
            <a href={url(item.path)}>
              <div class="headline tw:[.site-data_.data-item_.data-item-link_&]:whitespace-nowrap tw:[.relatedPosts_&]:flex tw:[.relatedPosts_&]:items-center">
                <I18n k={item.name} />
              </div>
              <div class="length-num">{item.count}</div>
            </a>
          </div>
        </div>
      ))}
      {cfg.comment.sidebar &&
        cfg.comment.use.toLowerCase().includes("valine") && (
          <div class="data-item is-center tw:[.site-data_&]:flex tw:[.site-data_&]:justify-start">
            <div class="data-item-link">
              <a href={url(cfg.recent_comments.page)}>
                <div class="headline tw:[.site-data_.data-item_.data-item-link_&]:whitespace-nowrap tw:[.relatedPosts_&]:flex tw:[.relatedPosts_&]:items-center">
                  <I18n k="comments" />
                </div>
                <div class="length-num" id="valine_allcount">
                  <i class="solitude fas fa-spinner fa-spin" />
                </div>
              </a>
            </div>
          </div>
        )}
    </div>
    <div class="mobile-menu-features">
      <span class="sidebar-menu-item-title"><I18n k="sidebarFeatures" /></span>
      <div class="sidebar-menu-item tw:[#sidebar_#sidebar-menus_&]:flex tw:[#sidebar_#sidebar-menus_&]:flex-col">
        {cfg.nav.right.random && (
          <button id="mobile-random-post" type="button" class="menu-child" data-solitude-action="randomPost">
            <i class="solitude fas fa-shuffle" aria-hidden="true" />
            <span><I18n k="randomPost" /></span>
          </button>
        )}
        {rssLink && (
          <a id="mobile-rss-feed" class="menu-child" href={url(rssLink.url ?? "/rss.xml")} data-astro-reload data-feed-link data-feed-en={url("/en/rss.xml")} data-feed-zh={url("/rss.xml")}>
            <i class={rssLink.icon || "fas fa-rss"} aria-hidden="true" />
            <span><I18n text={rssLink.name} /></span>
          </a>
        )}
        {themeSwitch && (
          <button id="mobile-theme-toggle" type="button" class="darkmode_switchbutton menu-child" data-solitude-action={themeSwitch.action ?? "toggleTheme"}>
            <i class={themeSwitch.icon || "fas fa-circle-half-stroke"} aria-hidden="true" />
            <span><I18n k="displayMode" /></span>
          </button>
        )}
        <button id="mobile-language-switch" type="button" class="menu-child" data-ui-language-switch aria-label="Switch to Chinese">
          <i class="solitude fas fa-language" aria-hidden="true" />
          <span data-ui-language-label>中文</span>
        </button>
      </div>
    </div>
    <span class="sidebar-menu-item-title"><I18n k="sidebarNavigation" /></span>
    <Menu mobile />
    <span class="sidebar-menu-item-title"><I18n k="tags" /></span>
    <div class="card-tags">
      <div class="card-tag-cloud tw:overflow-hidden tw:relative tw:flex tw:flex-row tw:flex-wrap tw:[#console_.console-card.tags_&]:flex tw:[#console_.console-card.tags_&]:flex-wrap tw:[#sidebar_#sidebar-menus_&]:flex tw:[#sidebar_#sidebar-menus_&]:whitespace-nowrap tw:[#sidebar_#sidebar-menus_&]:flex-row tw:[#sidebar_#sidebar-menus_&]:flex-wrap">
        {tags.slice(0, cfg.aside.tags.limit).map((tag) => (
          <a
            href={url(tag.path)}
            class={
              cfg.aside.tags.highlight_list.includes(tag.name)
                ? "highlight"
                : undefined
            }
          >
            {tag.name}
            <sup>{tag.posts.length}</sup>
          </a>
        ))}
      </div>
      {tags.length >= cfg.aside.tags.limit && (
        <a class="more-tags-btn" href={url("/tags/")}>
          <I18n k="moreTags" />
        </a>
      )}
    </div>
    <span class="sidebar-menu-item-title"><I18n k="siteInformation" /></span>
    <div class="webinfo tw:[#sidebar_#sidebar-menus_&]:flex tw:[#sidebar_#sidebar-menus_&]:whitespace-nowrap tw:[#sidebar_#sidebar-menus_&]:flex-col">
      {cfg.aside.siteinfo.postcount && (
        <div class="webinfo-item tw:flex tw:flex-row tw:justify-between tw:[#sidebar_#sidebar-menus_.webinfo_&]:justify-between">
          <div class="item-name"><I18n k="posts" /></div>
          <div class="item-count">{posts.length}</div>
        </div>
      )}
      {cfg.aside.siteinfo.runtimeenable && (
        <div class="webinfo-item tw:flex tw:flex-row tw:justify-between tw:[#sidebar_#sidebar-menus_.webinfo_&]:justify-between">
          <div class="item-name"><I18n k="uptime" /></div>
          <div class="item-count runtimeshow" />
        </div>
      )}
      {cfg.aside.siteinfo.updatetime && (
        <div class="webinfo-item tw:flex tw:flex-row tw:justify-between tw:[#sidebar_#sidebar-menus_.webinfo_&]:justify-between">
          <div class="item-name"><I18n k="lastUpdated" /></div>
          <time class="item-count" datetime={isoDate(updated)}>
            {dateLabel(updated)}
          </time>
        </div>
      )}
      {cfg.aside.siteinfo.wordcount && (
        <div class="webinfo-item tw:flex tw:flex-row tw:justify-between tw:[#sidebar_#sidebar-menus_.webinfo_&]:justify-between">
          <div class="item-name"><I18n k="totalWords" /></div>
          <div class="item-count">
            <ArticleWordTotal posts={posts} />
          </div>
        </div>
      )}
    </div>
  </div>
</div>
{cfg.rightside.enable && (
  <div id="rightside" class="needEndHide">
    <div id="rightside-config-hide" class="rs_hide">
      {cfg.translate.enable && cfg.rightside.hide.translate && (
        <button
          id="translateLink"
          class="translate"
          type="button"
          aria-label="Translate"
        >
          繁
        </button>
      )}
      {cfg.rightside.hide.mode && (
        <button
          class="mode darkmode_switchbutton tw:[#sidebar_#sidebar-menus_.sidebar-menu-item_&]:cursor-pointer"
          type="button"
          data-solitude-action="toggleTheme"
          aria-label={t("toggleTheme")} data-i18n-aria-label={"toggleTheme"}
        >
          <i class="solitude fas fa-circle-half-stroke" />
        </button>
      )}
      {cfg.rightside.hide.aside && cfg.console.enable && (
        <button
          class="aside pc"
          type="button"
          data-solitude-action="switchHideAside"
          aria-label={t("toggleAside")} data-i18n-aria-label={"toggleAside"}
        >
          <i class="solitude fas fa-arrows-left-right-to-line" />
        </button>
      )}
    </div>
    <div id="rightside-config-show" class="rs_show">
      {cfg.rightside.hide.enable && (
        <button
          id="rightside-config"
          class="config"
          type="button"
          data-solitude-action="toggleTargetClass"
          data-solitude-target="#rightside-config-hide"
          aria-label={t("settings")} data-i18n-aria-label={"settings"}
        >
          <i class="solitude fas fa-gear" />
        </button>
      )}
      {toc && (
        <button
          class="mobile toc"
          type="button"
          data-solitude-toc-toggle
          aria-controls="card-toc"
          aria-expanded="false"
          aria-label={t("toc")} data-i18n-aria-label={"toc"}
        >
          <i class="solitude fas fa-list" />
        </button>
      )}
      {comments && (
        <button
          class="comment rightside-comment"
          type="button"
          data-solitude-action="scrollTo"
          data-solitude-target="post-comment"
          aria-label={t("comments")} data-i18n-aria-label={"comments"}
        >
          <i class="solitude fas fa-comment" />
        </button>
      )}
    </div>
  </div>
)}
{cfg.right_menu.enable && (
  <>
    <nav id="rightMenu" aria-label={t("rightMenuLabel")} data-i18n-aria-label={"rightMenuLabel"}>
      <div class="rightMenu-group rightMenu-small">
        {[
          ["backward", "arrow-left", "rightMenuBack"],
          ["forward", "arrow-right", "rightMenuForward"],
          ["refresh", "arrows-rotate", "rightMenuRefresh"],
          ["top", "arrow-up", "backTop"],
        ].map(([id, icon, label]) => (
          <button
            class="rightMenu-item"
            id={`menu-${id}`}
            type="button"
            aria-label={t(label)} data-i18n-aria-label={label}
            title={t(label)} data-i18n-title={label}
          >
            <i class={`solitude fas fa-${icon}`} />
          </button>
        ))}
      </div>
      <div class="rightMenu-group rightMenu-line rightMenuPlugin">
        {contextItems.map(([id, icon, label]) => (
          <button
            class="rightMenu-item"
            id={`menu-${id}`}
            type="button"
            title={t(label)} data-i18n-title={label}
          >
            <i class={`solitude fas fa-${icon}`} />
            <span><I18n k={label} /></span>
          </button>
        ))}
      </div>
      <div class="rightMenu-group rightMenu-line rightMenuOther">
        {cfg.right_menu.custom_list.map((item) => (
          <button
            class={`rightMenu-item ${item.class ?? ""}`}
            id={item.id}
            type="button"
            data-solitude-action="runConfiguredAction"
            data-solitude-value={item.click}
          >
            <i class={`solitude ${item.icon}`} />
            <span><I18n text={item.name} /></span>
          </button>
        ))}
        <button
          class="rightMenu-item"
          id="menu-aside"
          type="button"
          data-solitude-action="switchHideAside"
          aria-controls="aside-content"
          hidden
          style="display:none"
        >
          <i class="solitude fas fa-table-columns" aria-hidden="true" />
          <span class="menu-aside-text"><I18n k="rightMenuAsideHide" /></span>
        </button>
        {cfg.comment.use &&
          cfg.comment.commentBarrage &&
          cfg.right_menu.commentBarrage && (
            <button
              class="rightMenu-item"
              id="menu-commentBarrage"
              data-solitude-action="switchCommentBarrage"
            >
              <i class="solitude fas fa-comment" />
              <span class="menu-commentBarrage-text">
                <I18n k="rightMenuBarrageClose" />
              </span>
            </button>
          )}
        <button
          class="rightMenu-item"
          id="menu-darkmode"
          type="button"
          data-solitude-action="switchDarkMode"
        >
          <i class="solitude fas fa-circle-half-stroke" />
          <span class="menu-darkmode-text"><I18n k="rightMenuDark" /></span>
        </button>
        {cfg.right_menu.translate && (
          <button class="rightMenu-item" id="menu-translate" type="button">
            <i class="solitude fas fa-language" />
            <span><I18n k="rightMenuToTraditional" /></span>
          </button>
        )}
      </div>
      <div class="rightMenu-group rightMenu-line rightMenu-language">
        <button
          class="rightMenu-item"
          id="menu-language"
          type="button"
          data-ui-language-switch
          aria-label="Switch to Chinese"
          title="Switch to Chinese"
        >
          <i class="solitude fas fa-language" aria-hidden="true" />
          <span data-ui-language-label>中文</span>
        </button>
      </div>
    </nav>
    <div id="rightmenu-mask" />
  </>
)}
