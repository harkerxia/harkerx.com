---
import I18n from "./I18n.astro";
import { cfg, t, url, termPath, dateLabel, isoDate } from '../lib/site';
import { contentPath, legacyPostPath, postIdentity, type Post } from '../lib/content';
interface Props {
  post: Post;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const p = post.data;
const right =
  cfg.index_post_list.direction !== 'column' &&
  (cfg.index_post_list.cover === 'right' ||
    (cfg.index_post_list.cover === 'both' && index % 2 === 1));
---

<article
  class="recent-post-item tw:flex tw:items-center tw:overflow-hidden tw:cursor-pointer"
  style={right ? 'flex-direction:row-reverse' : undefined}
  data-article-id={postIdentity(post)}
  data-article-bind="data-solitude-url:path"
  data-solitude-action="navigateTo"
  data-solitude-url={url(contentPath(post))}
>
  <div class={`post_cover ${index % 2 ? 'right' : 'left'}`}>
    <a href={url(contentPath(post))} title={p.title} data-article-bind="href:path;title:title">
      <img
        class="post_bg nolazyload tw:[.recent-post-item_.post\_cover_img&]:object-cover"
        src={url(p.cover ?? cfg.post.default.cover[0])}
        alt={p.title} data-article-bind="alt:title"
        loading="lazy"
        data-solitude-fallback={url(cfg.post.default.cover[0])}
      />
    </a>
  </div>
  <div class="recent-post-info tw:[.recent-post-item_>_&]:cursor-pointer tw:[.recent-post-item_>_&]:relative tw:[.recent-post-item_>_&]:flex tw:[.recent-post-item_>_&]:overflow-hidden tw:[.recent-post-item_>_&]:flex-col tw:[.recent-post-item_>_&]:justify-between">
    <div class="recent-post-info-top tw:[.recent-post-item_>_.recent-post-info_&]:relative">
      <div class="recent-post-info-top-tips tw:[.recent-post-item_>_.recent-post-info_.recent-post-info-top_&]:flex">
        {p.sticky && (
          <span class="article-meta sticky-warp tw:[.article-meta-wrap_>_&]:whitespace-nowrap tw:[.article-meta-wrap_>_&]:overflow-hidden tw:[.article-meta-wrap_>_&]:flex tw:[.recent-post-item_>_.recent-post-info_.recent-post-info-top_.recent-post-info-top-tips_>_&]:flex tw:[.recent-post-item_>_.recent-post-info_.recent-post-info-top_.recent-post-info-top-tips_>_&]:relative tw:[.recent-post-item_>_.recent-post-info_.recent-post-info-top_.recent-post-info-top-tips_>_&]:justify-center tw:[.recent-post-item_>_.recent-post-info_.recent-post-info-top_.recent-post-info-top-tips_>_&]:items-center">
            <i class="solitude fas fa-thumbtack sticky orange" />
            <span class="sticky orange"><I18n k="homeSticky" /></span>
          </span>
        )}
        {p.categories.map((c) => (
          <span class="original tw:[.recent-post-item_>_.recent-post-info_.recent-post-info-top_.recent-post-info-top-tips_&]:flex tw:[.recent-post-item_>_.recent-post-info_.recent-post-info-top_.recent-post-info-top-tips_&]:relative">
            {c}
          </span>
        ))}
        <a
          class="unvisited-post tw:[.recent-post-item_>_.recent-post-info_.recent-post-info-top_.recent-post-info-top-tips_&]:flex tw:[.recent-post-item_>_.recent-post-info_.recent-post-info-top_.recent-post-info-top-tips_&]:relative"
          href={url(contentPath(post))} data-article-bind="href:path"
        >
          <I18n k="homeRead" />
        </a>
      </div>
      <a
        class="article-title tw:[.recent-post-item_>_.recent-post-info_.recent-post-info-top_&]:overflow-hidden"
        href={url(contentPath(post))}
        title={p.title} data-article-bind="href:path;title:title" data-article-text="title"
      >
        {p.title}
      </a>
      <small class="article-language-label" data-article-language hidden>中文</small>
      <p class="article-description" data-article-text="description" hidden={!p.description?.trim()}>{p.description}</p>
    </div>
    <div class="article-meta-wrap tw:relative tw:flex tw:flex-row tw:justify-between tw:items-center tw:whitespace-nowrap">
      {p.comment && (
        <div
          class="post-card-commenters tw:flex tw:items-center"
          data-comment-path={url(legacyPostPath(post))}
          hidden
        />
      )}
      {p.tags.length > 0 && (
        <span class="article-meta tags tw:[.article-meta-wrap_>_&]:whitespace-nowrap tw:[.article-meta-wrap_>_&]:overflow-hidden tw:[.article-meta-wrap_>_&]:flex">
          {p.tags.map((tag) => (
            <a
              class="article-meta__tags"
              href={url(termPath('tags', tag))}
              data-solitude-action="noop"
              data-solitude-stop="true"
            >
              <span class="tags-punctuation tw:[span&]:flex tw:[span&]:items-center tw:[#post_.post-tools-right_.tag\_share_.post-meta\_\_tag-list_.post-meta\_\_tags_span&]:flex tw:[#post_.post-tools-right_.tag\_share_.post-meta\_\_tag-list_.post-meta\_\_tags_span&]:items-center">
                <i class="solitude fas fa-hashtag" />
                {tag}
              </span>
            </a>
          ))}
        </span>
      )}
      <span class="post-card-meta-details">
        {cfg.interactions.enable && (
          <span class="post-card-stats" data-post-stats={postIdentity(post)}>
            <span class="post-card-stat" title={t("pageViews")} data-i18n-title="pageViews">
              <i class="solitude fas fa-eye" aria-hidden="true" />
              <span data-post-views>—</span>
            </span>
            <span class="post-card-stat" title={t("postLikes")} data-i18n-title="postLikes">
              <i class="solitude fas fa-heart" aria-hidden="true" />
              <span data-post-likes>—</span>
            </span>
          </span>
        )}
        <span class="post-meta-date">
          <time datetime={isoDate(p.date)}>{dateLabel(p.date)}</time>
        </span>
      </span>
    </div>
  </div>
</article>
