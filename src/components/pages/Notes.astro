---
import notes from "../../data/notes.json";
import I18n from "../I18n.astro";
import { cfg, config, dateLabel, t, url } from "../../lib/site";
import type { NotesData } from "../../lib/page-types";
interface Props {
  data?: NotesData;
}
const data: NotesData = Astro.props.data ?? notes;
const c = cfg.notes;
const header = data.header;
const items = data.items.slice(0, c.strip);
---

{c.enable && (
  <>
    <header class="author-content author-content-item single sharePage notes-header tw:relative tw:[.author-content.author-content-item&]:overflow-hidden">
      {header?.cover && (
        <img
          class="notes-header-cover tw:absolute tw:object-cover"
          src={url(header.cover)}
          alt=""
          fetchpriority="high"
        />
      )}
      <img
        class="notes-header-lighthouse"
        src={url("/img/notes-lighthouse.svg")}
        alt=""
        aria-hidden="true"
        decoding="async"
      />
      <div class="card-content tw:[#aside-content_.card-widget_&]:relative tw:[#aside-content_.card-widget_&]:flex tw:[#aside-content_.card-widget_&]:flex-col tw:[.author-content-item_&]:absolute tw:[.author-content-item_&]:flex tw:[.author-content-item_&]:flex-col">
        <div class="author-content-item-tips">
          {header?.description ? <I18n text={header.description} /> : <I18n k="notesDescription" />}
        </div>
        <h1 class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
          {data.title ? <I18n text={data.title} /> : <I18n k="notes" />}
        </h1>
        <div class="banner-button-group tw:[div#banners_&]:absolute tw:[div#banners_&]:flex tw:[.author-content-item_.card-content_&]:absolute">
          <a
            class="banner-button tw:[div#banners_&]:flex tw:[div#banners_&]:items-center tw:[div#banners_&]:cursor-pointer tw:[.author-content-item_.card-content_.banner-button-group_&]:justify-center tw:[.author-content-item_.card-content_.banner-button-group_&]:flex tw:[.author-content-item_.card-content_.banner-button-group_&]:items-center tw:[.author-content-item_.card-content_.banner-button-group_&]:cursor-pointer"
            href={url(header?.button?.link || "/archives/")}
            aria-label={header?.button?.text || t("notesReadMore")}
            data-i18n-aria-label={header?.button?.text ? undefined : "notesReadMore"}
            data-i18n-aria-label-text={header?.button?.text}
          >
            <i
              class="solitude fas fa-circle-chevron-right"
              aria-hidden="true"
            />
            <span class="banner-button-text">
              {header?.button?.text ? <I18n text={header.button.text} /> : <I18n k="notesReadMore" />}
            </span>
          </a>
        </div>
      </div>
    </header>
    <solitude-notes id="notes" data-style={c.style} class="tw:block">
      <section class="timeline page-1">
        <ul class="list waterfall tw:[#notes_&]:grid tw:[#notes_&]:relative">
          {items.map((item) => (
            <li class="item">
              {c.style === 2 && (
                <div class="meta tw:[#notes_&]:flex tw:[#notes_&]:items-center">
                  <img
                    class="avatar tw:[.card-info_&]:absolute tw:[#notes_&]:object-cover"
                    src={url(cfg.aside.my_card.author.img)}
                    alt=""
                  />
                  <div class="info">
                    <span class="notes_nick">{config.author.name}</span>
                    <time
                      class="notes_date"
                      datetime={item.date.replace(" ", "T")}
                      title={item.date}
                    >
                      {dateLabel(item.date.replace(" ", "T"))}
                    </time>
                  </div>
                </div>
              )}
              <div class="notes-content">
                <p class="datacont" lang={item.contentEn?.trim() ? undefined : "zh-CN"}><I18n text={item.contentEn?.trim() ? item.contentEn : item.content} zh={item.content} /></p>
                {item.image && (
                  <div class="notes-content-img tw:[#notes_&]:flex">
                    {(Array.isArray(item.image)
                      ? item.image
                      : [item.image]
                    ).map((img) => (
                      <img
                        src={url(typeof img === "string" ? img : img.url)}
                        alt={
                          typeof img === "string"
                            ? item.content
                            : (img.alt ?? item.content)
                        }
                        loading="lazy"
                        decoding="async"
                      />
                    ))}
                  </div>
                )}
              </div>
              {c.music && item.aplayer && (
                <div class="notes-music tw:[#notes_&]:overflow-hidden">
                  <solitude-meting
                    server={item.aplayer.server}
                    type="song"
                    id={item.aplayer.id}
                    mutex="true"
                    preload="none"
                    theme="var(--efu-main)"
                    data-lrctype="0"
                  />
                </div>
              )}
              {item.video && (
                <div class="notes-video tw:[#notes_&]:grid">
                  {item.video.player && (
                    <video
                      src={url(item.video.player)}
                      controls
                      preload="metadata"
                    />
                  )}
                  {item.video.bilibili && <iframe
                    src={`https://player.bilibili.com/player.html?autoplay=0&bvid=${encodeURIComponent(item.video.bilibili)}`}
                    title="Bilibili video"
                    loading="lazy"
                    allowfullscreen
                  ></iframe>}
                </div>
              )}
              {(c.style === 1 || item.location || item.link) && (
                <>
                  <hr />
                  <div class="notes-bottom">
                    <div class="notes-info tw:[#notes_&]:flex tw:[#notes_&]:flex-wrap tw:[#notes_&]:items-center">
                      {c.style === 1 && (
                        <div class="notes-info-time">
                          <i class="solitude fas fa-calendar-day" />
                          <time
                            datetime={item.date.replace(" ", "T")}
                            title={item.date}
                          >
                            {dateLabel(item.date.replace(" ", "T"))}
                          </time>
                        </div>
                      )}
                      {item.location && (
                        <div class="notes-info-location">
                          <i class="solitude fas fa-location-dot" />
                          {item.location}
                        </div>
                      )}
                      {item.link && (
                        <a class="notes-content-link" href={url(item.link)}>
                          <i class="solitude fas fa-link" />
                          <I18n k="notesLink" />
                        </a>
                      )}
                    </div>
                  </div>
                </>
              )}
            </li>
          ))}
        </ul>
        <div id="notes-tips" class="tw:text-center">
          {items.length
            ? <I18n k="notesCount" values={{ count: items.length }} />
            : <I18n k="notesEmpty" />}
        </div>
      </section>
    </solitude-notes>
  </>
)}

<script>
  import "../../scripts/notes";
</script>
