    "fancyapps_js": "https://cdn.jsdelivr.net/npm/@fancyapps/ui@6.1.14/dist/fancybox/fancybox.umd.js",
    "mermaid": "https://cdn.jsdelivr.net/npm/mermaid@11.16.0/dist/mermaid.min.js",
    "chart": "https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js",
    "abcjs": "https://cdn.jsdelivr.net/npm/abcjs@6.6.4/dist/abcjs-basic-min.js",
    "typeit": "https://cdn.jsdelivr.net/npm/typeit@8.8.7/dist/index.umd.min.js",
