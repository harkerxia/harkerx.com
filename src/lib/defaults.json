{
  "site": {
    "name": {
      "class": "text",
      "custom": ""
    },
    "icon": "/img/icons/favicon.png"
  },
  "nav": {
    "group": {},
    "right": {
      "random": true,
      "order": ["search-button", "randomPost_button", "rss-feed", "theme-toggle"],
      "custom": [
        {
          "name": "Toggle theme",
          "icon": "fas fa-circle-half-stroke",
          "action": "switchDarkMode",
          "id": "theme-toggle"
        },
        {
          "name": "RSS Feed",
          "icon": "fas fa-rss",
          "url": "/rss.xml",
          "id": "rss-feed"
        }
      ]
    }
  },
  "hometop": {
    "enable": true,
    "recommendList": []
  },
  "aside": {
    "position": 1,
    "home": {
      "noSticky": "about",
      "Sticky": "allInfo"
    },
    "post": {
      "noSticky": "about",
      "Sticky": "newestPost,allInfo"
    },
    "page": {
      "noSticky": "about",
      "Sticky": "newestPost,allInfo"
    },
    "my_card": {
      "author": {
        "img": "/img/avatar.png",
        "emoji": null,
        "sticker": null
      },
      "description": "",
      "content": "",
      "state": {
        "morning": "Good morning",
        "noon": "Good noon",
        "afternoon": "Good afternoon",
        "night": "Good evening",
        "goodnight": "Good night"
      },
      "witty_words": [],
      "information": []
    },
    "toc": {
      "post": true,
      "page": true
    },
    "tags": {
      "enable": true,
      "limit": 20,
      "highlight_list": []
    },
    "siteinfo": {
      "postcount": true,
      "wordcount": true,
      "updatetime": true,
      "runtimeenable": true,
      "runtime": "2026-10-1 00:00:00"
    }
  },
  "page": {
    "links": {
      "async_threshold": 200
    },
    "default": {
      "cover": ["/img/default-cover.svg"]
    }
  },
  "post": {
    "default": {
      "cover": ["/img/default-cover.svg"],
      "locate": ""
    },
    "meta": {
      "date": true,
      "locate": false,
      "wordcount": true,
      "readtime": true,
      "pv": false,
      "comment": false
    },
    "covercolor": {
      "enable": true,
      "mode": "local",
      "api": "https://api.qjqq.cn/api/Imgcolor?img=",
      "time": 43200000
    }
  },
  "theme_color": {
    "dark": "#ffc848",
    "light": "#425aef",
    "nav_hover_text": {
      "dark": "#1b1c20",
      "light": "#ffffff"
    }
  },
  "display_mode": {
    "type": "auto"
  },
  "font": {
    "font_size": "16px",
    "code_font_size": "16px",
    "font_family": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "code_font_family": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "index_post_list": {
    "direction": "column",
    "column": 2,
    "cover": "both"
  },
  "related_post": {
    "enable": true,
    "limit": 3,
    "date_type": "created"
  },
  "expire": {
    "enable": false,
    "time": 30,
    "position": "top",
    "text_prev": "This post was last updated ",
    "text_next": " days ago. Some information may be out of date."
  },
  "right_menu": {
    "enable": true,
    "exclude": ["music"],
    "commentBarrage": false,
    "ctrlOriginalMenu": false,
    "translate": false,
    "music": false,
    "img_error": "Unable to download image",
    "mode": {
      "dark": "Dark mode",
      "light": "Light mode"
    },
    "barrage": {
      "open": "Show comment barrage",
      "close": "Hide comment barrage"
    },
    "custom_list": []
  },
  "mermaid": true,
  "chart": true,
  "typeit": true,
  "console": {
    "enable": false,
    "recentComment": {
      "enable": false,
      "storage": 0.2
    },
    "card": {
      "tags": true,
      "archive": "month"
    }
  },
  "translate": {
    "enable": false,
    "defaultEncoding": 2,
    "translateDelay": 0
  },
  "rightside": {
    "enable": false,
    "hide": {
      "enable": true,
      "translate": true,
      "mode": true,
      "aside": true
    }
  },
  "footer": {
    "randomlink": false,
    "information": {
      "author": "",
      "left": [],
      "right": []
    },
    "group": {},
    "links": [],
    "beian": []
  },
  "capsule": {
    "enable": false,
    "id": "",
    "server": "netease",
    "type": "playlist",
    "volume": 0.8
  },
  "music": {
    "enable": false,
    "id": "",
    "server": "netease",
    "type": "playlist",
    "volume": 0.8,
    "mutex": true,
    "order": "list"
  },
  "meting_api": "https://meting.efu.me/?server=:server&type=:type&id=:id&r=:r",
  "keyboard": {
    "enable": false,
    "list": []
  },
  "lazyload": {
    "enable": true,
    "placeholder": "",
    "errorimg": "/img/image-unavailable.svg"
  },
  "loading": {
    "fullpage": false,
    "pace": true
  },
  "highlight": {
    "enable": true,
    "copy": true,
    "line_numbers": true,
    "themes": {
      "light": "github-light",
      "dark": "github-dark"
    },
    "max_height": 360
  },
  "lightbox": "fancybox",
  "memorial": {
    "enable": false,
    "date": []
  },
  "katex": {
    "enable": true,
    "copytex": true
  },
  "pwa": {
    "enable": true,
    "manifest": "/manifest.json",
    "theme_color": "#425aef",
    "mask_icon": "",
    "apple_touch_icon": "/img/icons/favicon.png",
    "favicon_32_32": "/img/icons/favicon-32.png",
    "favicon_16_16": "/img/icons/favicon-16.png",
    "bookmark_icon": "/img/icons/favicon.png"
  },
  "comment": {
    "use": "twikoo",
    "commentBarrage": false,
    "lazyload": false,
    "count": false,
    "sidebar": false,
    "pv": false,
    "avatar": "https://weavatar.com",
    "newest_comment": {
      "enable": false,
      "storage": 0.5,
      "limit": 5
    }
  },
  "twikoo": {
    "envId": "",
    "region": "",
    "accessToken": "",
    "option": {}
  },
  "waline": {
    "serverURL": "",
    "pageview": false,
    "option": {}
  },
  "valine": {
    "appId": "",
    "appKey": "",
    "serverURLs": "",
    "avatar": "mp",
    "visitor": false,
    "style": true,
    "option": {}
  },
  "artalk": {
    "server": "",
    "site": "",
    "option": {}
  },
  "giscus": {
    "repo": "",
    "repo_id": "",
    "category_id": "",
    "mapping": "pathname",
    "theme": {
      "light": "light",
      "dark": "dark"
    },
    "option": {}
  },
  "search": {
    "enable": true,
    "type": "local",
    "tags": [],
    "local": {
      "preload": true,
      "CDN": "/search.xml"
    },
    "algolia": {
      "appId": "",
      "apiKey": "",
      "indexName": "",
      "hits": {
        "per_page": 6
      }
    },
    "docsearch": {
      "appId": "",
      "apiKey": "",
      "indexName": "",
      "placeholder": "",
      "option": {}
    }
  },
  "envelope": {
    "enable": false,
    "line": 10,
    "speed": 20,
    "hover": true,
    "loop": true,
    "page": "/message/"
  },
  "notes": {
    "enable": true,
    "music": false,
    "page": "/notes/",
    "style": 1,
    "strip": 30
  },
  "recent_comments": {
    "enable": false,
    "limit": 50,
    "cache": 0.2,
    "page": "/recentcomments/"
  },
  "errorpage": {
    "img": "/img/404.png",
    "text": "Looks like you're wandering off course...",
    "recommendList": true
  },
  "verify_site": [],
  "extends": {
    "head": [],
    "body": []
  },
  "cdn": {
