---
import I18n from "../../components/I18n.astro";
import { cfg, config, t, url, dateLabel, json } from '../../lib/site';
import { contentPath, postIdentity, getArticleVersions, selectArticleVersions, type Post } from '../../lib/content';
import { normalizeUiLocale } from '../../lib/ui-language';
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
const views = new Map(selectArticleVersions(await getArticleVersions(), normalizeUiLocale(config.locale))
  .map((version) => [postIdentity(version), version]));
const data = posts.map((p) => views.get(postIdentity(p)) ?? p).map((p) => ({
  id: postIdentity(p),
  title: p.data.title,
  url: url(contentPath(p)),
  cover: url(p.data.cover ?? cfg.post.default.cover[0]),
  primaryCategory: p.data.categories[0] ?? t('uncategorized'),
  dateLabel: dateLabel(p.data.date),
  year: new Intl.DateTimeFormat('en', {
    timeZone: config.timeZone,
    year: 'numeric',
  }).format(p.data.date),
}));
---

<div
  class="archive-page-shell tw:overflow-hidden"
  id="archives-page"
  data-per-page={config.pagination}
  data-initial-year="all"
  data-initial-page="1"
  data-label-error={t('archiveLoadError')} data-i18n-data-label-error="archiveLoadError"
  data-label-empty={t('archiveEmpty')} data-i18n-data-label-empty="archiveEmpty"
  data-label-uncategorized={t('uncategorized')} data-i18n-data-label-uncategorized="uncategorized"
  data-label-previous={t('previousPageShort')} data-i18n-data-label-previous="previousPageShort"
  data-label-next={t('nextPageShort')} data-i18n-data-label-next="nextPageShort"
>
  <section class="archive-page-section archive-page-section-toolbar">
    <div class="archive-page-toolbar tw:justify-between">
      <div
        class="archive-page-years"
        role="group"
        aria-label={t('archiveYearFilter')} data-i18n-aria-label="archiveYearFilter"
      >
        <button
          class="archive-year-button is-active"
          type="button"
          data-year="all"
          aria-pressed="true"
        >
          <I18n k="archiveAll" />
        </button>
        <div id="archives-year-filter-list" />
      </div>
    </div>
  </section>
  <section
    class="archive-page-section archive-page-section-list"
    aria-live="polite"
  >
    <div class="archive-page-list tw:grid" id="archives-page-list">
      {data.slice(0, config.pagination).map((p) => (
        <a class="archive-item" href={p.url} data-article-id={p.id} data-article-bind="href:path">
          <time>{p.dateLabel}</time> <span data-article-text="title">{p.title}</span>
          <small class="article-language-label" data-article-language hidden>中文</small>
        </a>
      ))}
    </div>
  </section>
  <section class="archive-page-section archive-page-section-pagination">
    <nav
      id="pagination"
      aria-label={t('paginationNavigation')} data-i18n-aria-label="paginationNavigation"
      class="tw:[#post_&]:overflow-hidden"
    >
      <div class="pagination" />
    </nav>
  </section>
</div>
<template id="archive-page-data" set:html={json(data)} />
