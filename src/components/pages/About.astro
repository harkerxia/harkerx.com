---
import about from "../../data/about.json";
import { url, json, t } from "../../lib/site";
import { marked } from "marked";
import I18n from "../I18n.astro";
import sourceZh from "../../i18n/site.zh-CN.json";
import type {
  AboutData,
  AboutTimeline,
  AboutTimelineEvent,
} from "../../lib/about-types";
interface Props {
  data?: AboutData;
}
const customZh = sourceZh as Record<string, string>;
const data: AboutData = Astro.props.data ?? about;
const careerStyle = (event: AboutTimelineEvent, timeline?: AboutTimeline) => {
  if (!timeline) return "";
  const span = timeline.end - timeline.start || 1;
  return `--career-left:${(100 * (event.from - timeline.start)) / span}%;--career-width:${(100 * ((event.to ?? event.from) - event.from)) / span}%;--career-color:${event.color ?? "var(--efu-main)"}`;
};
const careerEventLabel = (event: AboutTimelineEvent) => {
  const start = Math.floor(event.from);
  const end = event.to === undefined ? start : Math.floor(event.to);
  return `${event.label}, ${start === end ? start : `${start}–${end}`}`;
};
const allowed = [
  "intro",
  "skills_career",
  "personality_photo",
  "values",
  "interests",
  "stats_profile",
  "projects",
  "story",
];
if (!Array.isArray(data.sections))
  throw new Error("About data requires sections");
for (const section of data.sections)
  if (section.enabled !== false && !allowed.includes(section.type))
    throw new Error(`Unknown About section: ${section.type}`);
---

<section id="about-page" aria-labelledby="about-page-title">
  <h1
    class="about-page-title tw:[#about-page_&]:text-center"
    id="about-page-title"
  >
    <I18n text={data.title} />
  </h1>
  <div class="author-page-content tw:[#about-page_&]:flex tw:[#about-page_&]:flex-col">
    {data.sections
      .filter((s) => s.enabled !== false)
      .map((s) => (
        <>
          {s.type === "intro" && (
            <div class="author-content about-row about-row--intro">
              <article class="author-content-item about-intro-card">
                <div class="about-intro-heading">
                  <div>
                    <p class="about-card-copy"><I18n text={s.greeting} /></p>
                    <h2>
                      <I18n text={s.name_prefix} /> <span class="inline-word">{s.name}</span>
                    </h2>
                  </div>
                  {s.photo && (
                    <img class="about-intro-avatar" src={url(s.photo.image)} alt={s.photo.alt ?? ""} data-i18n-alt-text={s.photo.alt ?? ""} width="80" height="80" />
                  )}
                </div>
                <p class="about-card-copy"><I18n text={s.description} /></p>
                {s.links?.length && (
                  <nav class="about-links" aria-label="Profile links" data-i18n-aria-label-text="Profile links">
                    {s.links.map((link) => (
                      <a
                        href={url(link.url)}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                      >
                        {link.icon && <i class={link.icon} aria-hidden="true" />}
                        <I18n text={link.text} />
                      </a>
                    ))}
                  </nav>
                )}
              </article>
              <article class="author-content-item about-pursuit-card">
                <p class="author-content-item-tips"><I18n text={s.pursuit?.label} /></p>
                <h2>
                  {s.pursuit?.lines?.map((line: string) => (
                    <span><I18n text={line} /></span>
                  ))}
                  <span
                    class="about-word-mask tw:[#about-page_&]:relative tw:[#about-page_&]:block tw:[#about-page_&]:overflow-hidden"
                    aria-live="polite"
                  >
                    {s.pursuit?.rotating_words?.map(
                      (word: string, i: number) => (
                        <span
                          data-about-word
                          data-show={i === 0 ? "" : undefined}
                        >
                          <I18n text={word} />
                        </span>
                      ),
                    )}
                  </span>
                </h2>
                {s.pursuit?.description && (
                  <p class="about-pursuit-note"><I18n text={s.pursuit.description} /></p>
                )}
              </article>
            </div>
          )}
          {s.type === "skills_career" && (
            <div class="author-content about-row about-row--skills-career">
              <article class="author-content-item skills" tabindex="0">
                <div class="about-card-flow tw:[#about-page_&]:flex tw:[#about-page_&]:flex-col">
                  <p class="author-content-item-tips"><I18n text={s.skills?.label} /></p>
                  <h2 class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
                    <I18n text={s.skills?.title} />
                  </h2>
                  <div class="skills-style-group tw:[#about-page_&]:relative tw:[#about-page_&]:block">
                    <div
                      class="skills-marquee tw:[#about-page_&]:grid"
                      aria-hidden="true"
                    >
                      {[0, 1].map(() => (
                        <div class="skills-marquee-track tw:[#about-page_&]:flex">
                          {[0, 1].map(() => (
                            <div class="skills-marquee-set tw:[#about-page_&]:flex">
                              {s.skills?.items?.map((item) => (
                                <span
                                  class="skills-marquee-icon tw:[#about-page_&]:grid"
                                  style={`--skill-color:${item.color ?? "var(--efu-main)"}`}
                                >
                                  {item.image ? (
                                    <img src={url(item.image)} alt="" />
                                  ) : (
                                    <i class={item.icon ?? "fas fa-code"} />
                                  )}
                                </span>
                              ))}
                            </div>
                          ))}
                        </div>
                      ))}
                    </div>
                    <ul
                      class="skills-list tw:[#about-page_&]:absolute tw:[#about-page_&]:flex tw:[#about-page_&]:flex-wrap tw:[#about-page_&]:overflow-hidden"
                      aria-label={s.skills?.label} data-i18n-aria-label-text={s.skills?.label}
                    >
                      {s.skills?.items?.map((item) => (
                        <li class="skill-info tw:[#about-page_&]:flex tw:[#about-page_&]:items-center">
                          <span
                            class="skill-icon tw:[#about-page_&]:grid"
                            style={`--skill-color:${item.color ?? "var(--efu-main)"}`}
                          >
                            {item.image ? (
                              <img src={url(item.image)} alt="" />
                            ) : (
                              <i class={item.icon ?? "fas fa-code"} />
                            )}
                          </span>
                          <span class="skill-name tw:[#about-page_&]:overflow-hidden tw:[#about-page_&]:whitespace-nowrap">
                            <I18n text={item.name} />
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </article>
              <article class="author-content-item careers">
                <div class="about-card-flow tw:[#about-page_&]:flex tw:[#about-page_&]:flex-col">
                  <p class="author-content-item-tips"><I18n text={s.career?.label} /></p>
                  <h2 class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
                    <I18n text={s.career?.title} />
                  </h2>
                  <ul class="careers-summary tw:[#about-page_&]:grid">
                    {s.career?.summary?.map((item) => (
                      <li
                        style={`--career-color:${item.color ?? "var(--efu-main)"}`}
                      >
                        <span aria-hidden="true" />
                        <I18n text={item.name} />
                      </li>
                    ))}
                  </ul>
                  {s.career?.timeline && (
                    <div
                      class="career-timeline"
                      style={`--career-track-color:${s.career.timeline.events?.[0]?.color ?? "var(--efu-main)"}`}
                      role="group"
                      aria-label={
                        s.career.timeline.aria_label ?? s.career.title
                      }
                      data-i18n-aria-label-text={s.career.timeline.aria_label ?? s.career.title}
                    >
                      <p class="career-track-label tw:[#about-page_&]:absolute">
                        <I18n text={s.career.timeline.track_label ?? s.career.label} />
                      </p>
                      <div
                        class="career-timeline-axis tw:[#about-page_&]:absolute"
                        aria-hidden="true"
                      />
                      <i class="career-timeline-tick career-timeline-tick--start tw:[#about-page_&]:absolute" />
                      <i class="career-timeline-tick career-timeline-tick--end tw:[#about-page_&]:absolute" />
                      <ul
                        class="career-track tw:[#about-page_&]:absolute tw:[#about-page_&]:overflow-hidden"
                        aria-label={t("careerStages")} data-i18n-aria-label="careerStages"
                      >
                        {s.career.timeline.events?.map((event) => (
                          <li
                            class:list={[
                              "career-event",
                              { "career-event--milestone": event.to === undefined },
                            ]}
                            style={careerStyle(event, s.career?.timeline)}
                            tabindex="0"
                            aria-label={careerEventLabel(event)} data-i18n-aria-label-text={careerEventLabel(event)}
                            title={careerEventLabel(event)} data-i18n-title-text={careerEventLabel(event)}
                          >
                            <span
                              class="career-event-bar tw:[#about-page_&]:block"
                              aria-hidden="true"
                            />
                          </li>
                        ))}
                      </ul>
                      <div
                        class="career-timeline-years tw:[#about-page_&]:absolute"
                        aria-hidden="true"
                      >
                        <span>
                          {s.career.timeline.start_label ??
                            s.career.timeline.start}
                        </span>
                        <span>
                          <I18n text={String(s.career.timeline.end_label ?? s.career.timeline.end)} />
                        </span>
                      </div>
                    </div>
                  )}
                </div>
              </article>
            </div>
          )}
          {s.type === "personality_photo" && (
            <div class="author-content about-row about-row--personality-photo">
              <article
                class="author-content-item personalities tw:[#about-page_&]:flex tw:[#about-page_&]:flex-col"
                data-personality-type={s.personality?.type}
                style={`--personality-color:${s.personality?.color ?? "var(--efu-main)"}`}
              >
                <p class="author-content-item-tips"><I18n text={s.personality?.label} /></p>
                <h2 class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
                  <I18n text={s.personality?.title} />
                </h2>
                <p
                  class="personality-type"
                  style={`--personality-color:${s.personality?.color ?? "var(--efu-main)"}`}
                >
                  {s.personality?.type}
                </p>
                {s.personality?.image && (
                  <img
                    class="personality-image nolazyload tw:[#about-page_.personalities_>_&]:absolute"
                    src={url(s.personality.image)}
                    alt={s.personality.image_alt ?? ""}
                  />
                )}{" "}
                {s.personality?.link && (
                  <a
                    class="personality-link tw:[#about-page_.personalities_>_&]:absolute"
                    href={url(s.personality.link.url)}
                    target={s.personality.link.external ? "_blank" : undefined}
                    rel="noopener noreferrer"
                  >
                    <I18n text={s.personality.link.text} />
                  </a>
                )}
              </article>
              {s.photo && (
                <figure class="author-content-item myphoto" tabindex="0">
                  <img
                    class="author-content-img nolazyload tw:[#about-page_.myphoto_>_&]:absolute tw:[#about-page_.myphoto_>_&]:object-cover"
                    src={url(s.photo.image)}
                    alt={s.photo.alt ?? ""} data-i18n-alt-text={s.photo.alt ?? ""}
                  />
                  {s.photo.badge && (
                    <img
                      class="myphoto-badge nolazyload tw:[#about-page_.myphoto_>_&]:absolute tw:[#about-page_.myphoto_>_&]:object-cover"
                      src={url(s.photo.badge)}
                      alt=""
                    />
                  )}
                </figure>
              )}
            </div>
          )}
          {s.type === "values" && (
            <div class="author-content about-row about-row--values">
              <article class="author-content-item maxim">
                <p class="author-content-item-tips"><I18n text={s.motto?.label} /></p>
                <h2>
                  <span><I18n text={s.motto?.prefix} /></span>
                  <span><I18n text={s.motto?.content} /></span>
                </h2>
              </article>
              <article class="author-content-item buff">
                <p class="author-content-item-tips"><I18n text={s.expertise?.label} /></p>
                <h2>
                  <span>
                    <I18n text={s.expertise?.prefix} />
                    <strong><I18n text={s.expertise?.specialist} /></strong>
                  </span>
                  <span>
                    <I18n text={s.expertise?.content} /> <strong><I18n text={s.expertise?.level} /></strong>
                  </span>
                </h2>
              </article>
            </div>
          )}
          {s.type === "interests" && (
            <div class="author-content about-row about-row--interests">
              {s.items?.map((item) => (
                <article
                  class={`author-content-item interest-card interest-card--${item.variant ?? "media"}`}
                  tabindex="0"
                  style={`${item.background ? `--interest-background:url('${url(item.background)}');` : ""}--interest-color:${item.color ?? "var(--efu-main)"}`}
                >
                  <div class="interest-card-content tw:[#about-page_&]:flex tw:[#about-page_&]:flex-col">
                    <p class="author-content-item-tips"><I18n text={item.label} /></p>
                    <h2 class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
                      {(
                        item.title_lines ?? (item.title ? [item.title] : [])
                      ).map((line: string) => (
                        <span><I18n text={line} /></span>
                      ))}
                      {item.mode?.image && (
                        <img
                          class="interest-mode-image tw:[#about-page_&]:object-cover"
                          src={url(item.mode.image)}
                          alt={item.mode.name}
                          title={item.mode.tooltip ?? item.mode.name}
                        />
                      )}
                    </h2>
                    <div class="interest-card-footer tw:[#about-page_&]:flex tw:[#about-page_&]:items-center tw:[#about-page_&]:justify-between">
                      {item.heroes && (
                        <ul
                          class="interest-heroes tw:[#about-page_&]:flex tw:[#about-page_&]:items-center"
                          aria-label={t("favoriteHeroes")} data-i18n-aria-label="favoriteHeroes"
                        >
                          {item.heroes.map((hero, i: number) => (
                            <li style={`--hero-index:${i}`}>
                              <img
                                src={url(hero.image)}
                                alt={hero.name}
                                title={hero.name}
                              />
                            </li>
                          ))}
                        </ul>
                      )}
                      <p class="interest-subtitle"><I18n text={item.subtitle} /></p>
                      <p
                        class="interest-right-text tw:[#about-page_&]:whitespace-nowrap"
                        title={item.right_tip}
                      >
                        <I18n text={item.right_text} />
                      </p>
                      {item.button && (
                        <a
                          class="about-card-button tw:[#about-page_&]:inline-flex tw:[#about-page_&]:items-center tw:[#about-page_&]:justify-center tw:[#about-page_&]:cursor-pointer tw:[#about-page_.interest-card_&]:relative tw:[#about-page_.interest-card_&]:whitespace-nowrap"
                          href={url(item.button.url)}
                          target={item.button.external ? "_blank" : undefined}
                          rel="noopener noreferrer"
                        >
                          {item.button.icon && <i class={item.button.icon} />}
                          <span><I18n text={item.button.text} /></span>
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
          {s.type === "stats_profile" && (
            <div class="author-content about-row about-row--stats-profile">
              <article
                class="author-content-item about-statistics"
                data-about-stats
                style={
                  s.statistics?.background
                    ? `--statistics-background:url('${url(s.statistics.background)}')`
                    : undefined
                }
              >
                <p class="author-content-item-tips"><I18n text={s.statistics?.label} /></p>
                <h2 class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
                  <I18n text={s.statistics?.title} />
                </h2>
                <dl class="about-statistics-list tw:[#about-page_&]:grid">
                  {s.statistics?.metrics?.map((m) => (
                    <div>
                      <dt><I18n text={m.label} /></dt>
                      <dd data-about-metric={m.field}>{m.fallback}</dd>
                    </div>
                  ))}
                </dl>
                {s.statistics?.button && (
                  <a
                    class="about-card-button tw:[#about-page_&]:inline-flex tw:[#about-page_&]:items-center tw:[#about-page_&]:justify-center tw:[#about-page_&]:cursor-pointer tw:[#about-page_.interest-card_&]:relative tw:[#about-page_.interest-card_&]:whitespace-nowrap"
                    href={url(s.statistics.button.url)}
                  >
                    <I18n text={s.statistics.button.text} />
                  </a>
                )}
                <script
                  is:inline
                  type="application/json"
                  data-about-stats-config
                  set:html={json({
                    source: s.statistics?.source,
                    metrics: s.statistics?.metrics,
                  })}
                ></script>
              </article>
              <article
                class="author-content-item about-map tw:[#about-page_&]:flex tw:[#about-page_&]:flex-col"
                tabindex="0"
              >
                <p class="author-content-item-tips"><I18n text={s.location?.label} /></p>
                <h2 class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
                  <I18n text={s.location?.title} />
                </h2>
                <div
                  class="about-map-visual tw:[#about-page_.author-content-item_>_&]:absolute"
                  aria-hidden="true"
                >
                  {s.location?.map_light && (
                    <img
                      class="about-map-image about-map-image--light tw:[#about-page_&]:object-cover"
                      src={url(s.location.map_light)}
                      alt=""
                    />
                  )}
                  {s.location?.map_dark && (
                    <img
                      class="about-map-image about-map-image--dark tw:[#about-page_&]:object-cover"
                      src={url(s.location.map_dark)}
                      alt=""
                    />
                  )}
                </div>
              </article>
              <article class="author-content-item about-profile">
                <p class="author-content-item-tips"><I18n text={s.profile?.label} /></p>
                <h2 class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
                  <I18n text={s.profile?.title} />
                </h2>
                <dl class="about-profile-list tw:[#about-page_&]:grid">
                  {s.profile?.items?.map((item) => (
                    <div>
                      {item.icon && <i class={item.icon} />}
                      <dt><I18n text={item.label} /></dt>
                      <dd><I18n text={item.value} /></dd>
                    </div>
                  ))}
                </dl>
              </article>
            </div>
          )}
          {s.type === "projects" && (
            <section class="about-projects" aria-label={s.title} data-i18n-aria-label-text={s.title}>
              <div class="about-section-heading">
                <div>
                  <p class="author-content-item-tips"><I18n text={s.label} /></p>
                  <h2><I18n text={s.title} /></h2>
                </div>
                {s.links?.map((link) => (
                  <a
                    class="about-text-link"
                    href={url(link.url)}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                  >
                    {link.icon && <i class={link.icon} aria-hidden="true" />}
                    <I18n text={link.text} />
                    <i class="fas fa-arrow-up-right-from-square" aria-hidden="true" />
                  </a>
                ))}
              </div>
              <div class="about-project-grid">
                {s.projects?.map((project) => (
                  <article
                    class="author-content-item about-project-card"
                    style={`--project-color:${project.color ?? "var(--efu-theme)"}`}
                  >
                    <div class="about-project-meta">
                      <span class="about-project-icon" aria-hidden="true">
                        <i class={project.icon ?? "fas fa-code"} />
                      </span>
                      {project.status && <span><I18n text={project.status} /></span>}
                    </div>
                    <h3>
                      {project.url ? (
                        <a href={url(project.url)} target="_blank" rel="noopener noreferrer">
                          {project.name}
                          <i class="fas fa-arrow-up-right-from-square" aria-hidden="true" />
                        </a>
                      ) : project.name}
                    </h3>
                    <p class="about-project-description"><I18n text={project.description} /></p>
                    {project.tags?.length && (
                      <ul class="about-tags" aria-label={`${project.name} technologies`} data-i18n-aria-label-text={`${project.name} technologies`}>
                        {project.tags.map((tag) => <li><I18n text={tag} /></li>)}
                      </ul>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )}
          {s.type === "story" && (
            <article class="author-content-item about-story">
              <p class="author-content-item-tips"><I18n text={s.label} /></p>
              <h2 class="author-content-item-title tw:[#console_&]:flex tw:[#console_&]:items-center tw:[#console_&]:justify-between tw:[#about-page_.interest-card_&]:flex tw:[#about-page_.interest-card_&]:items-start tw:[#about-page_.interest-card_&]:justify-between tw:[#about-page_.interest-card--media_&]:block">
                <I18n text={s.title} />
              </h2>
              <div
                class="about-story-content"
                data-i18n-html
                data-i18n-text={marked.parse(s.content ?? "")}
                data-i18n-zh={marked.parse(customZh[s.content ?? ""] ?? s.content ?? "")}
                set:html={marked.parse(s.content ?? "")}
              />
              {s.tags?.length && (
                <ul class="about-tags" aria-label="Site technologies" data-i18n-aria-label-text="Site technologies">
                  {s.tags.map((tag) => <li><I18n text={tag} /></li>)}
                </ul>
              )}
              {s.links?.length && (
                <nav class="about-links" aria-label="Explore this site" data-i18n-aria-label-text="Explore this site">
                  {s.links.map((link) => (
                    <a
                      href={url(link.url)}
                      data-feed-link={link.url === "/rss.xml" ? "" : undefined}
                      data-feed-en={link.url === "/rss.xml" ? url("/en/rss.xml") : undefined}
                      data-feed-zh={link.url === "/rss.xml" ? url("/rss.xml") : undefined}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                    >
                      {link.icon && <i class={link.icon} aria-hidden="true" />}
                      <I18n text={link.text} />
                    </a>
                  ))}
                </nav>
              )}
            </article>
          )}
        </>
      ))}
  </div>
</section>
